  "options": {
    "step": {
      "init": {
        "title": "Fronius Modbus TCP options",
        "description": "Writing entities change the inverter's behaviour. \"Inverter control via Modbus\" must be enabled in the Fronius web interface; grid operator settings (control priorities) take precedence.",
        "data": {
          "allow_control": "Allow control"
        },
        "data_description": {
          "allow_control": "Creates entities for power limitation, feed-in (standby), fallback time, battery control (charge/discharge limits, minimum reserve, charging from grid – devices with storage only) and – for Datamanager devices – resetting events."
        }
      }
    }
  },
